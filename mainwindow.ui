  <property name="styleSheet">
   <string notr="true">
/* ==================== 全局 ==================== */
QWidget {
    background-color: #20242B;
    color: #DCE1E8;
    font-family: &quot;Microsoft YaHei UI&quot;;
    font-size: 13px;
}

/* ==================== 单行输入框 ==================== */
QLineEdit {
    background-color: #292F38;
    color: #E6EDF3;
    border: 1px solid #3B4350;
    border-radius: 6px;
    padding: 7px 10px;
    min-height: 20px;
    selection-background-color: #3478F6;
    selection-color: #FFFFFF;
}

QLineEdit:hover {
    border-color: #596579;
}

QLineEdit:focus {
    border: 1px solid #3478F6;
    background-color: #2B323D;
}

QLineEdit:disabled {
    color: #707987;
    background-color: #252930;
    border-color: #303640;
}

/* ==================== 下拉框 ==================== */
QComboBox {
    background-color: #292F38;
    color: #E6EDF3;
    border: 1px solid #3B4350;
    border-radius: 6px;
    padding: 7px 10px;
    min-height: 20px;
}

QComboBox:hover {
    border-color: #596579;
}

QComboBox:focus {
    border: 1px solid #3478F6;
}

QComboBox::down-arrow {
    image: none;
    width: 0px;
    height: 0px;
    border-left: 5px solid transparent;
    border-right: 5px solid transparent;
    border-top: 6px solid #B9C5D5;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 30px;
    border: none;
    border-left: 1px solid #3B4350;
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
}

QComboBox QAbstractItemView {
    background-color: #292F38;
    color: #E6EDF3;
    border: 1px solid #454E5C;
    selection-background-color: #3478F6;
    selection-color: #FFFFFF;
    outline: none;
    padding: 4px;
}

QComboBox QAbstractItemView::item {
    min-height: 28px;
    padding: 4px 8px;
}

QComboBox QAbstractItemView::item:hover {
    background-color: #353E4B;
}

/* ==================== 按钮通用样式 ==================== */
QPushButton {
    background-color: #343C48;
    color: #E6EDF3;
    border: 1px solid #46505F;
    border-radius: 6px;
    padding: 8px 18px;
    min-height: 20px;
}

QPushButton:hover {
    background-color: #414B5A;
    border-color: #5A687B;
}

QPushButton:pressed {
    background-color: #29313C;
}

QPushButton:disabled {
    background-color: #292E36;
    color: #707987;
    border-color: #343A44;
}

/* ==================== 主操作按钮 ==================== */
/* 在 Qt Designer 中给下载按钮设置对象名称：btnDownload */
QPushButton#btnDownload {
    background-color: #3478F6;
    color: #FFFFFF;
    border: 1px solid #3478F6;
    font-weight: bold;
}

QPushButton#btnDownload:hover {
    background-color: #4A89FF;
    border-color: #4A89FF;
}

QPushButton#btnDownload:pressed {
    background-color: #2463D6;
    border-color: #2463D6;
}

/* ==================== 多行日志输出 ==================== */
QPlainTextEdit {
    background-color: #343C48;
    color: #B9C5D5;
    border: 1px solid #353D49;
    border-radius: 6px;
    padding: 10px;
    selection-background-color: #3478F6;
    selection-color: #FFFFFF;
    font-family: &quot;Consolas&quot;;
    font-size: 12px;
}

QPlainTextEdit:focus {
    border: 1px solid #465A78;
}

QPlainTextEdit:disabled {
    color: #707987;
    background-color: #20242B;
}
</string>
